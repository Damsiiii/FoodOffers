---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import offersData from '../data/offers.json';

const vendors = offersData.vendors || [];
const allOffers = offersData.all_offers || [];
---

<Layout title="Sri Lanka Food Offers & Deals | Live Tracker">
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">
    <!-- Hero Banner -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-red-950 via-gray-900 to-amber-950 border border-gray-800 p-6 sm:p-10 mb-8">
      <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-red-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 max-w-2xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-red-500/20 text-red-400 border border-red-500/30 mb-4">
          🔥 Best Discounts in Sri Lanka
        </span>
        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-4 leading-tight">
          Save Big on Your Favorite <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-amber-400">Food Chains</span>
        </h2>
        <p class="text-gray-300 text-sm sm:text-base leading-relaxed mb-6">
          Compare live discounts, meal combos, and bucket deals across 14 mainstream Sri Lankan fast food vendors with automated real-time price tracking.
        </p>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="mb-8 space-y-4">
      <div class="flex flex-col sm:flex-row gap-4 items-center justify-between">
        <!-- Search Input -->
        <div class="relative w-full sm:w-96">
          <input
            type="text"
            id="search-input"
            placeholder="Search deals, burgers, pizza, biryani..."
            class="w-full bg-gray-900 border border-gray-800 text-gray-100 rounded-xl px-4 py-3 pl-10 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition text-sm"
          />
          <svg class="w-5 h-5 text-gray-500 absolute left-3 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>

        <div class="text-xs text-gray-400 flex items-center gap-2 self-start sm:self-auto">
          <span>Showing <strong id="visible-count" class="text-white">{allOffers.length}</strong> deals</span>
        </div>
      </div>

      <!-- Vendor Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
        <button
          class="vendor-tab active-tab bg-red-600 text-white font-semibold text-xs sm:text-sm px-4 py-2 rounded-xl transition whitespace-nowrap"
          data-vendor="all"
        >
          All Vendors ({allOffers.length})
        </button>
        {vendors.map((vendor: any) => (
          <button
            class="vendor-tab bg-gray-900 hover:bg-gray-800 text-gray-300 font-medium text-xs sm:text-sm px-4 py-2 rounded-xl border border-gray-800 transition whitespace-nowrap flex items-center gap-2"
            data-vendor={vendor.vendor_id}
          >
            <span>{vendor.vendor_name}</span>
            <span class="bg-gray-800 text-gray-400 text-xs px-1.5 py-0.5 rounded-md">{vendor.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Offers Grid -->
    <div id="offers-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {allOffers.map((offer: any) => (
        <div
          class="offer-card group bg-gray-900 border border-gray-800 hover:border-gray-700 rounded-2xl overflow-hidden shadow-lg transition duration-300 flex flex-col"
          data-vendor={offer.vendor_id}
          data-title={offer.title.toLowerCase()}
          data-category={(offer.category || '').toLowerCase()}
          data-description={(offer.description || '').toLowerCase()}
        >
          <!-- Image Container -->
          <div class="relative h-48 overflow-hidden bg-gray-950">
            <img
              src={offer.image_url}
              alt={offer.title}
              class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent opacity-80"></div>

            <!-- Discount Badge -->
            <div class="absolute top-3 right-3 bg-red-600 text-white font-extrabold text-xs px-2.5 py-1 rounded-lg shadow-md">
              {offer.discount_percentage}% OFF
            </div>

            <!-- Vendor Badge -->
            <div class="absolute bottom-3 left-3 flex items-center gap-2 bg-gray-900/90 backdrop-blur px-2.5 py-1 rounded-lg border border-gray-700/50">
              <span class="text-xs font-semibold text-gray-200">{offer.vendor_name}</span>
            </div>

            {offer.is_fallback && (
              <div class="absolute top-3 left-3 bg-amber-500/20 text-amber-400 text-[10px] font-bold px-2 py-0.5 rounded border border-amber-500/30 backdrop-blur">
                Offline Cached
              </div>
            )}
          </div>

          <!-- Content Container -->
          <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <div class="flex items-center justify-between text-xs text-gray-400 mb-1">
                <span class="text-amber-400 font-medium">{offer.category}</span>
                <span>{offer.deal_type}</span>
              </div>
              <h3 class="text-lg font-bold text-white group-hover:text-red-400 transition line-clamp-1">
                {offer.title}
              </h3>
              <p class="text-gray-400 text-xs line-clamp-2 mt-1">
                {offer.description}
              </p>
            </div>

            <!-- Pricing & Action -->
            <div class="pt-3 border-t border-gray-800/80 flex items-center justify-between">
              <div>
                <span class="text-xs text-gray-500 line-through mr-1.5">LKR {offer.original_price}</span>
                <span class="text-xl font-extrabold text-white">LKR {offer.discounted_price}</span>
              </div>
              <a
                href={offer.source_url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 bg-red-600 hover:bg-red-500 text-white text-xs font-bold px-3 py-2 rounded-xl transition shadow-md shadow-red-600/20"
              >
                Get Deal
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="no-results" class="hidden text-center py-16 bg-gray-900/50 border border-gray-800 rounded-2xl my-8">
      <div class="text-4xl mb-3">🔍</div>
      <h3 class="text-lg font-bold text-white mb-1">No offers found</h3>
      <p class="text-gray-400 text-sm">Try searching for something else or pick a different vendor tab.</p>
    </div>
  </main>

  <footer class="border-t border-gray-800 bg-gray-950 py-8 mt-12 text-center text-xs text-gray-500">
    <div class="max-w-7xl mx-auto px-4">
      <p class="mb-2">🇱🇰 LankaFoodOffers • Automated Sri Lanka Fast Food Deals Engine</p>
      <p>Built with Python, Astro, Tailwind CSS & GitHub Pages.</p>
    </div>
  </footer>

  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const vendorTabs = document.querySelectorAll('.vendor-tab');
    const offerCards = document.querySelectorAll('.offer-card');
    const visibleCount = document.getElementById('visible-count');
    const noResults = document.getElementById('no-results');

    let activeVendor = 'all';
    let searchQuery = '';

    function filterOffers() {
      let count = 0;
      offerCards.forEach((card) => {
        const vendor = card.getAttribute('data-vendor');
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const desc = card.getAttribute('data-description') || '';

        const matchesVendor = activeVendor === 'all' || vendor === activeVendor;
        const matchesSearch = !searchQuery ||
          title.includes(searchQuery) ||
          category.includes(searchQuery) ||
          desc.includes(searchQuery);

        if (matchesVendor && matchesSearch) {
          (card as HTMLElement).style.display = 'flex';
          count++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (visibleCount) visibleCount.textContent = count.toString();
      if (noResults) {
        if (count === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    vendorTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        vendorTabs.forEach((t) => {
          t.classList.remove('active-tab', 'bg-red-600', 'text-white');
          t.classList.add('bg-gray-900', 'text-gray-300');
        });

        tab.classList.add('active-tab', 'bg-red-600', 'text-white');
        tab.classList.remove('bg-gray-900', 'text-gray-300');

        activeVendor = tab.getAttribute('data-vendor') || 'all';
        filterOffers();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterOffers();
    });
  </script>
</Layout>
