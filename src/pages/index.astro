---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import offersData from '../data/offers.json';

const vendors = offersData.vendors || [];
const allOffers = offersData.all_offers || [];
---

<Layout title="Lanka Food Offer Ledger | Sri Lanka Fast Food Deals">
  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full space-y-8">

    <!-- Hero / Editorial Context Header -->
    <section class="border-l-2 border-spice-700 pl-4 sm:pl-6 py-1 max-w-3xl">
      <p class="font-mono text-xs text-spice-600 uppercase tracking-widest mb-1.5 font-semibold">
        Official Market Bulletin
      </p>
      <h2 class="font-serif text-3xl sm:text-4xl text-paper-50 font-semibold tracking-tight leading-snug">
        Compare active fast food deals, meal buckets & promotional discounts in Sri Lanka.
      </h2>
      <p class="text-paper-200 text-sm sm:text-base leading-relaxed mt-3">
        Independent automated scraper monitoring prices across 14 food chains. Updated continuously with direct links to vendor ordering platforms.
      </p>
    </section>

    <!-- Controls Bar: Search & Vendor Filter -->
    <section class="space-y-4 pt-2">
      <div class="flex flex-col sm:flex-row gap-4 items-stretch sm:items-center justify-between border-b border-paper-850 pb-4">

        <!-- Search Field -->
        <div class="relative w-full sm:w-80">
          <input
            type="text"
            id="search-input"
            placeholder="Search deals (e.g., burger, pizza, bucket)..."
            class="w-full bg-paper-900 border border-paper-800 text-paper-100 placeholder-paper-200 text-xs px-3.5 py-2.5 pl-9 focus:outline-none focus:border-spice-700 transition font-mono"
          />
          <svg class="w-4 h-4 text-paper-200 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>

        <div class="font-mono text-xs text-paper-200 flex items-center gap-2">
          <span>INDEXED DEALS: <strong id="visible-count" class="text-spice-600 font-bold">{allOffers.length}</strong></span>
        </div>
      </div>

      <!-- Vendor Filter Chips -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-2 scrollbar-none font-mono text-xs">
        <button
          class="vendor-tab active-tab bg-spice-700 text-paper-50 px-3 py-1.5 border border-spice-600 font-medium transition whitespace-nowrap"
          data-vendor="all"
        >
          All Vendors [{allOffers.length}]
        </button>
        {vendors.map((vendor: any) => (
          <button
            class="vendor-tab bg-paper-900 hover:bg-paper-850 text-paper-200 px-3 py-1.5 border border-paper-800 transition whitespace-nowrap flex items-center gap-1.5"
            data-vendor={vendor.vendor_id}
          >
            <span>{vendor.vendor_name}</span>
            <span class="text-paper-200 text-[10px]">({vendor.count})</span>
          </button>
        ))}
      </div>
    </section>

    <!-- Offers Grid Ledger -->
    <section id="offers-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {allOffers.map((offer: any) => (
        <article
          class="offer-card group bg-paper-900 border border-paper-800 hover:border-paper-700 transition duration-200 flex flex-col justify-between"
          data-vendor={offer.vendor_id}
          data-title={offer.title.toLowerCase()}
          data-category={(offer.category || '').toLowerCase()}
          data-description={(offer.description || '').toLowerCase()}
        >
          <div>
            <!-- Image & Header Tag Header -->
            <div class="relative h-44 overflow-hidden bg-paper-950 border-b border-paper-850">
              <img
                src={offer.image_url}
                alt={offer.title}
                class="w-full h-full object-cover group-hover:scale-102 transition duration-300 filter contrast-105"
                loading="lazy"
              />

              <!-- Off Tag Badge -->
              <div class="absolute top-2.5 right-2.5 bg-spice-700 text-white font-mono font-bold text-xs px-2 py-0.5 border border-spice-600 shadow-sm">
                -{offer.discount_percentage}%
              </div>

              <!-- Vendor Tag Badge -->
              <div class="absolute bottom-2.5 left-2.5 bg-paper-950/90 text-paper-200 font-mono text-[11px] px-2 py-0.5 border border-paper-800">
                {offer.vendor_name}
              </div>

              {offer.is_fallback && (
                <div class="absolute top-2.5 left-2.5 bg-paper-950/90 text-amber-500 font-mono text-[10px] px-2 py-0.5 border border-amber-800/60">
                  Cached Data
                </div>
              )}
            </div>

            <!-- Main Info Block -->
            <div class="p-4 space-y-2.5">
              <div class="flex items-center justify-between font-mono text-[11px] text-paper-200">
                <span class="text-spice-600 uppercase font-medium">{offer.category}</span>
                <span class="text-paper-200">{offer.deal_type}</span>
              </div>

              <h3 class="font-serif text-lg font-semibold text-paper-50 group-hover:text-spice-600 transition leading-snug line-clamp-1">
                {offer.title}
              </h3>

              <p class="text-paper-200 text-xs leading-relaxed line-clamp-2">
                {offer.description}
              </p>
            </div>
          </div>

          <!-- Footer Price Bar & Deal Link -->
          <div class="p-4 pt-3 border-t border-paper-850/80 bg-paper-950/40 flex items-center justify-between">
            <div>
              <div class="text-[10px] font-mono text-paper-200 line-through">LKR {offer.original_price}</div>
              <div class="text-base font-mono font-bold text-paper-50">LKR {offer.discounted_price}</div>
            </div>

            <a
              href={offer.source_url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 bg-paper-850 hover:bg-spice-700 hover:text-white text-paper-200 font-mono text-xs px-3 py-1.5 border border-paper-700 hover:border-spice-600 transition"
            >
              <span>Claim Deal</span>
              <span class="text-xs">→</span>
            </a>
          </div>
        </article>
      ))}
    </section>

    <!-- Empty Filter State -->
    <div id="no-results" class="hidden text-center py-16 bg-paper-900 border border-paper-800 my-8">
      <div class="font-mono text-xs text-spice-600 uppercase tracking-widest mb-2">[ No Matches ]</div>
      <h3 class="font-serif text-xl font-semibold text-paper-50 mb-1">No deals match your search criteria</h3>
      <p class="text-paper-200 text-xs font-mono">Adjust search terms or select another vendor filter above.</p>
    </div>

  </main>

  <footer class="border-t border-paper-850 bg-paper-950 py-8 mt-16 text-xs font-mono text-paper-200">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <p class="text-paper-200 font-medium">Lanka Food Offer Ledger • Open Fast Food Intelligence</p>
        <p class="text-[11px] text-paper-200 mt-0.5">Automated scrapers powered by Python, Astro static SSR, Tailwind CSS & GitHub Actions.</p>
      </div>
      <div class="text-[11px] text-paper-200">
        Prices updated periodically from official Sri Lanka vendor platforms.
      </div>
    </div>
  </footer>

  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const vendorTabs = document.querySelectorAll('.vendor-tab');
    const offerCards = document.querySelectorAll('.offer-card');
    const visibleCount = document.getElementById('visible-count');
    const noResults = document.getElementById('no-results');

    let activeVendor = 'all';
    let searchQuery = '';

    function filterOffers() {
      let count = 0;
      offerCards.forEach((card) => {
        const vendor = card.getAttribute('data-vendor');
        const title = card.getAttribute('data-title') || '';
        const category = card.getAttribute('data-category') || '';
        const desc = card.getAttribute('data-description') || '';

        const matchesVendor = activeVendor === 'all' || vendor === activeVendor;
        const matchesSearch = !searchQuery ||
          title.includes(searchQuery) ||
          category.includes(searchQuery) ||
          desc.includes(searchQuery);

        if (matchesVendor && matchesSearch) {
          (card as HTMLElement).style.display = 'flex';
          count++;
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });

      if (visibleCount) visibleCount.textContent = count.toString();
      if (noResults) {
        if (count === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    vendorTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        vendorTabs.forEach((t) => {
          t.classList.remove('active-tab', 'bg-spice-700', 'text-paper-50', 'border-spice-600');
          t.classList.add('bg-paper-900', 'text-paper-200', 'border-paper-800');
        });

        tab.classList.add('active-tab', 'bg-spice-700', 'text-paper-50', 'border-spice-600');
        tab.classList.remove('bg-paper-900', 'text-paper-200', 'border-paper-800');

        activeVendor = tab.getAttribute('data-vendor') || 'all';
        filterOffers();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterOffers();
    });
  </script>
</Layout>
