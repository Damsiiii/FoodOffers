---
import offersData from '../data/offers.json';

const totalVendors = offersData.total_vendors || 0;
const totalOffers = offersData.total_offers || 0;
const lastUpdated = offersData.last_updated
  ? new Date(offersData.last_updated).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })
  : 'LIVE';
---

<header class="border-b-2 border-border bg-background sticky top-0 z-50">
  <div class="max-w-[95vw] mx-auto px-4 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">

    <!-- Brand Title Lockup -->
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 border-2 border-border bg-accent text-accent-foreground flex items-center justify-center font-bold text-base tracking-tighter uppercase rounded-none">
        LK
      </div>
      <div>
        <h1 class="font-bold text-xl sm:text-2xl tracking-tighter uppercase text-foreground leading-none">
          Lanka Food Offer Ledger
        </h1>
      </div>
    </div>

    <!-- Status Stats & Location Selector -->
    <div class="flex flex-wrap items-center gap-3 text-sm font-bold uppercase tracking-tight text-foreground border-t-2 md:border-t-0 border-border pt-3 md:pt-0">

      <!-- Location Selector Toggle -->
      <div class="flex items-center gap-2 px-3 py-2 bg-background border-2 border-border text-foreground hover:border-accent transition-colors duration-200">
        <span class="text-accent font-bold">●</span>
        <span class="text-muted-foreground text-xs tracking-wider">REGION:</span>
        <select id="location-selector" class="bg-transparent text-foreground font-bold focus:outline-none cursor-pointer uppercase tracking-tight text-xs">
          <option value="colombo" class="bg-background text-foreground">COLOMBO (LK-1)</option>
          <option value="kandy" class="bg-background text-foreground">KANDY (LK-2)</option>
          <option value="galle" class="bg-background text-foreground">GALLE (LK-3)</option>
          <option value="negombo" class="bg-background text-foreground">NEGOMBO (LK-4)</option>
          <option value="all" class="bg-background text-foreground">ALL SRI LANKA</option>
        </select>
      </div>

      <div class="flex items-center gap-2 px-3 py-2 bg-background border-2 border-border">
        <span class="w-2 h-2 bg-emerald-500 rounded-none"></span>
        <span>{totalVendors} CHAINS</span>
      </div>

      <div class="flex items-center gap-2 px-3 py-2 bg-accent text-accent-foreground border-2 border-accent">
        <span class="font-extrabold">{totalOffers}</span>
        <span>ACTIVE PROMOS</span>
      </div>

      <div class="hidden lg:block text-xs font-mono text-muted-foreground pl-3 border-l-2 border-border">
        SYNCED: <time class="text-foreground font-bold">{lastUpdated}</time>
      </div>
    </div>

  </div>
</header>
